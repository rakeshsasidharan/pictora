{
  // Type-checks against core's source, so `npm run typecheck` doesn't need core built first. `next build`
  // uses tsconfig.json and core's dist, since Turbopack doesn't map core's `.js` imports to its `.ts` files.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@pictora/core": ["../packages/core/src/index.ts"],
      "@pictora/core/registry-store": ["../packages/core/src/registry_store.ts"]
    }
  }
}
