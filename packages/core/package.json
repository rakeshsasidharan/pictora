{
  "name": "@pictora/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./registry-store": {
      "types": "./dist/src/registry_store.d.ts",
      "default": "./dist/src/registry_store.js"
    },
    "./observability": {
      "types": "./dist/src/observability.d.ts",
      "default": "./dist/src/observability.js"
    },
    "./abuse-store": {
      "types": "./dist/src/abuse_store.d.ts",
      "default": "./dist/src/abuse_store.js"
    },
    "./block-store": {
      "types": "./dist/src/block_store.d.ts",
      "default": "./dist/src/block_store.js"
    },
    "./metrics-store": {
      "types": "./dist/src/metrics_store.d.ts",
      "default": "./dist/src/metrics_store.js"
    },
    "./models.json": "./models.json"
  },
  "files": [
    "dist",
    "models.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/validate_models.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@aws-lambda-powertools/logger": "^2.36.0",
    "@aws-lambda-powertools/metrics": "^2.36.0",
    "@aws-sdk/client-dynamodb": "^3.1152.0",
    "@aws-sdk/lib-dynamodb": "^3.1152.0",
    "zod": "^4.6.7"
  }
}
