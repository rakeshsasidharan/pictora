{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    // Type-check against the packages' source, so checks don't need them built first. The build uses their dist.
    "paths": {
      "@pictora/core": ["../packages/core/src/index.ts"],
      "@pictora/core/registry-store": ["../packages/core/src/registry_store.ts"],
      "@pictora/core/observability": ["../packages/core/src/observability.ts"],
      "@pictora/core/block-store": ["../packages/core/src/block_store.ts"],
      "@pictora/providers": ["../packages/providers/src/index.ts"]
    }
  },
  "include": ["src", "test", "vitest.config.ts"]
}
